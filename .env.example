# ─────────────────────────────────────────────────────────────────────────────
#  Template de variáveis de ambiente — copie para .env e preencha.
#       cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco de dados: Supabase (Settings → Database → Connection string) ──────
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# ── Supabase Storage (Settings → API) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="SUA_SERVICE_ROLE_KEY_AQUI"
SUPABASE_STORAGE_BUCKET="products"

# ── Painel admin ────────────────────────────────────────────────────────────
ADMIN_USERNAME="admin"
# Gere com: node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA',10))"
# Importante: escape os cifrões (\$) por causa da expansão de variáveis do Next.
ADMIN_PASSWORD_HASH="\$2b\$10\$SUBSTITUA_PELO_SEU_HASH"
# Gere com: openssl rand -base64 32
AUTH_SECRET="SUBSTITUA_POR_UMA_CHAVE_ALEATORIA"
